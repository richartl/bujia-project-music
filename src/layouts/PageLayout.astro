---
// Layout para páginas sueltas (Nosotros, Privacidad, etc) escritas en
// .mdx. Se ve como un post normal del sitio — título arriba, contenido
// abajo, todo dentro de .container — no como el layout de fanzine
// (ese es fanzine:true en PostLayout, para los posts del zine). Adentro
// del contenido se pueden meter <PageCover /> u otros componentes de
// src/components/content/ para dar variedad visual sin salirse del
// formato de página.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="page">
    <div class="container">
      <header class="page__header">
        <h1 class="page__title">{title}</h1>
      </header>

      <div class="post-body">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    background: var(--paper);
    padding: 2.5rem 0;
  }
  .page__title {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 5vw, 3rem);
    margin: 0 0 1.5rem;
  }
</style>
