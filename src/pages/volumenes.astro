---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = await getCollection('posts', ({ data }) => data.fanzine && !data.draft);
const volumes = posts.sort((a, b) => (b.data.volume ?? 0) - (a.data.volume ?? 0));
---

<BaseLayout title="Volúmenes">
  <div class="container">
    <h1>Volúmenes</h1>
    <ul class="vol-list">
      {volumes.map((v) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}blog/${v.slug}`}>
            Vol. {v.data.volume} — {v.data.title}
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
