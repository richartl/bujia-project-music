---
import { getCollection } from 'astro:content';
import TallerLayout from '../../layouts/TallerLayout.astro';
import TallerCover from '../../components/taller/TallerCover.astro';
import SidebarBox from '../../components/taller/SidebarBox.astro';
import RelatedItemRow from '../../components/taller/RelatedItemRow.astro';
import FollowUsCard from '../../components/taller/FollowUsCard.astro';
import PrevNextNav from '../../components/taller/PrevNextNav.astro';

export async function getStaticPaths() {
  const rawItems = await getCollection('catalog', ({ data }) => data.enabled);
  const items = rawItems.sort((a, b) => a.data.order - b.data.order);
  return items.map((item, index) => ({
    params: { slug: item.slug },
    props: {
      item,
      prevItem: items[index - 1] ?? null,
      nextItem: items[index + 1] ?? null,
      otherItems: items.filter((i) => i.slug !== item.slug).slice(0, 4),
    },
  }));
}

const { item, prevItem, nextItem, otherItems } = Astro.props;
const { Content } = await item.render();
const { name, price, currency, image, category, soldOut, excerpt } = item.data;

const categoryLabel = category === 'servicio' ? 'Servicio' : 'Producto';
const priceLabel = price != null ? `$${price.toLocaleString('es-MX')} ${currency}` : undefined;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);
---

<TallerLayout title={name} description={excerpt}>
  <div class="container-wide">
    <TallerCover tag={categoryLabel} title={name} subtitle={priceLabel} colorScheme="rosa">
      <article class="catalog-detail">
        <a href={withBase('/catalogo')} class="catalog-detail__back">← Volver al catálogo</a>

        <div class="catalog-detail__wrap">
          <div class="catalog-detail__layout">
            <div class="catalog-detail__img" style={`background-image:url(${withBase(image)})`}>
              {soldOut && <span class="catalog-detail__badge">Agotado</span>}
            </div>

            <div class="post-body catalog-detail__body">
              <Content />
            </div>
          </div>

          <aside class="catalog-detail__sidebar">
            {otherItems.length > 0 && (
              <SidebarBox title="Más del catálogo">
                {otherItems.map((other) => (
                  <RelatedItemRow
                    href={withBase(`/catalogo/${other.slug}`)}
                    image={withBase(other.data.image)}
                    title={other.data.name}
                  />
                ))}
              </SidebarBox>
            )}
            <FollowUsCard />
          </aside>
        </div>

        <PrevNextNav
          prevHref={prevItem ? withBase(`/catalogo/${prevItem.slug}`) : undefined}
          prevLabel={prevItem?.data.name}
          nextHref={nextItem ? withBase(`/catalogo/${nextItem.slug}`) : undefined}
          nextLabel={nextItem?.data.name}
        />
      </article>
    </TallerCover>
  </div>

  <style>
    .catalog-detail__back {
      display: inline-block;
      text-decoration: none;
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.85rem;
      text-transform: uppercase;
      margin-bottom: 1.2rem;
    }
    .catalog-detail__wrap {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    .catalog-detail__layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      align-items: start;
    }
    .catalog-detail__img {
      position: relative;
      aspect-ratio: 1 / 1;
      background-color: rgba(127, 127, 127, 0.15);
      background-size: cover;
      background-position: center;
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius);
    }
    .catalog-detail__badge {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.75rem;
      padding: 0.3em 0.8em;
      border-radius: 999px;
    }
    .catalog-detail__sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    @media (max-width: 960px) {
      .catalog-detail__wrap {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 720px) {
      .catalog-detail__layout {
        grid-template-columns: 1fr;
      }
    }
  </style>
</TallerLayout>
