---
import { getCollection } from 'astro:content';
import TallerLayout from '../../layouts/TallerLayout.astro';
import TallerCover from '../../components/taller/TallerCover.astro';
import CatalogCard from '../../components/taller/CatalogCard.astro';
import SectionLabel from '../../components/taller/SectionLabel.astro';
import { groupCatalogItems } from '../../lib/catalog';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);

const allItems = await getCollection('catalog', ({ data }) => data.enabled);
const items = allItems.sort((a, b) => a.data.order - b.data.order);
const groups = groupCatalogItems(items);
---

<TallerLayout title="Catálogo">
  <div class="container-wide">
    <TallerCover
      tag="Catálogo"
      title="Nuestro catálogo"
      subtitle="Productos y servicios hechos a mano en el taller"
      colorScheme="rosa"
    >
      {groups.map((group) => (
        <div class="catalog-group">
          <SectionLabel text={group.label} />
          <div class="catalog-grid">
            {group.items.map((item) => (
              <CatalogCard item={item} href={withBase(`/catalogo/${item.slug}`)} />
            ))}
          </div>
        </div>
      ))}
    </TallerCover>
  </div>

  <style>
    .catalog-group + .catalog-group {
      margin-top: 1.8rem;
    }
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.1rem;
    }
  </style>
</TallerLayout>
