---
import { getCollection } from 'astro:content';
import TallerLayout from '../../layouts/TallerLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);

const allItems = await getCollection('catalog', ({ data }) => data.enabled);
const items = allItems.sort((a, b) => a.data.order - b.data.order);

const formatPrice = (price: number, currency: string) => `$${price.toLocaleString('es-MX')} ${currency}`;
---

<TallerLayout title="Catálogo">
  <div class="container catalogo-page">
    <h1>Catálogo</h1>

    <div class="catalog-grid">
      {items.map((item) => (
        <a href={withBase(`/catalogo/${item.slug}`)} class="catalog-card">
          <span class="catalog-card__img" style={`background-image:url(${withBase(item.data.image)})`}>
            {item.data.soldOut && <span class="catalog-card__badge">Agotado</span>}
          </span>
          <span class="catalog-card__name">{item.data.name}</span>
          {item.data.price != null && (
            <span class="catalog-card__price">{formatPrice(item.data.price, item.data.currency)}</span>
          )}
        </a>
      ))}
    </div>
  </div>

  <style>
    .catalogo-page {
      padding: 2.5rem 0 4rem;
    }
    .catalogo-page h1 {
      font-family: var(--font-head);
      text-transform: uppercase;
      margin: 0 0 2rem;
    }
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 1.5rem;
    }
    .catalog-card {
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: var(--ink);
    }
    .catalog-card__img {
      position: relative;
      display: block;
      aspect-ratio: 1 / 1;
      background-color: rgba(127, 127, 127, 0.15);
      background-size: cover;
      background-position: center;
      border: var(--border-w) solid var(--ink);
      border-radius: var(--radius);
      margin-bottom: 0.8rem;
      transition: box-shadow 0.15s ease, transform 0.15s ease;
    }
    .catalog-card:hover .catalog-card__img {
      box-shadow: 6px 6px 0 var(--accent);
      transform: translate(-3px, -3px);
    }
    .catalog-card__badge {
      position: absolute;
      top: 0.7rem;
      left: 0.7rem;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-head);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.7rem;
      padding: 0.3em 0.7em;
      border-radius: 999px;
    }
    .catalog-card__name {
      font-family: var(--font-head);
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .catalog-card__price {
      font-family: var(--font-head);
      color: var(--logo-color, #ff5b52);
      font-size: 0.9rem;
      margin-top: 0.2rem;
    }
  </style>
</TallerLayout>
