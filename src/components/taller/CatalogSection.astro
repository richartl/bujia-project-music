---
// Sección "Nuestros productos" debajo del hero: grilla de productos y
// servicios que sale de src/content/catalog/*.md — agregar/quitar/editar
// uno es agregar/borrar/editar un .md ahí, sin tocar este componente.
// Cada ítem se prende/apaga con su propio `enabled`; la sección entera se
// apaga con taller.catalog.enabled en site.ts. Usa el mismo sistema de
// esquemas de color (rosa/acido/azul/negro) que las secciones del fanzine.
import { getCollection } from 'astro:content';
import { taller } from '../../config/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);

const allItems = taller.catalog.enabled ? await getCollection('catalog', ({ data }) => data.enabled) : [];
const sorted = allItems.sort((a, b) => a.data.order - b.data.order);
const items = sorted.slice(0, taller.catalog.limit);
const hasMore = sorted.length > items.length;

const formatPrice = (price: number, currency: string) =>
  `$${price.toLocaleString('es-MX')} ${currency}`;
---

{
  items.length > 0 && (
    <section class={`catalog-section scheme-${taller.catalog.colorScheme}`}>
      <div class="container catalog-section__in">
        <header class="catalog-section__head">
          <span class="fz-section-title">{taller.catalog.title}</span>
          {taller.catalog.subtitle && <p class="catalog-section__subtitle">{taller.catalog.subtitle}</p>}
        </header>

        <div class="catalog-grid">
          {items.map((item) => (
            <a href={withBase(`/catalogo/${item.slug}`)} class="catalog-card">
              <span
                class="catalog-card__img"
                style={`background-image:url(${withBase(item.data.image)})`}
              >
                {item.data.soldOut && <span class="catalog-card__badge">Agotado</span>}
              </span>
              <span class="catalog-card__name">{item.data.name}</span>
              {item.data.price != null && (
                <span class="catalog-card__price">{formatPrice(item.data.price, item.data.currency)}</span>
              )}
            </a>
          ))}
        </div>

        {(hasMore || taller.catalog.ctaLabel) && (
          <div class="catalog-section__cta-wrap">
            <a href={withBase(taller.catalog.ctaHref)} class="catalog-section__cta">
              {taller.catalog.ctaLabel}
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .catalog-section {
    background: var(--paper);
    color: var(--ink);
    padding: 3.5rem 0;
  }
  .catalog-section__head {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  /* Título del catálogo: reusa el "sticker" .fz-section-title del sitio
     pero con la display font Anton (tipo flyer/cartel punk) y mucho más
     grande, para que se note bien la sección. */
  .catalog-section__head :global(.fz-section-title) {
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    font-size: clamp(1.9rem, 7vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    padding: 0.35em 0.9em 0.3em;
  }
  .catalog-section__subtitle {
    font-family: var(--font-head);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.85;
    margin: 0.5rem 0 0;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .catalog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
  }
  .catalog-card__img {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background-color: rgba(127, 127, 127, 0.15);
    background-size: cover;
    background-position: center;
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    margin-bottom: 0.8rem;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .catalog-card:hover .catalog-card__img {
    box-shadow: 6px 6px 0 var(--accent);
    transform: translate(-3px, -3px);
  }
  .catalog-card__badge {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    padding: 0.3em 0.7em;
    border-radius: 999px;
  }
  .catalog-card__name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .catalog-card__price {
    font-family: var(--font-head);
    color: var(--accent);
    font-size: 0.9rem;
    margin-top: 0.2rem;
  }

  .catalog-section__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .catalog-section__cta {
    display: inline-block;
    text-decoration: none;
    background: var(--accent);
    color: var(--ink);
    border: var(--border-w) solid var(--ink);
    border-radius: 999px;
    padding: 0.7em 2em;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
</style>
