---
// Sección "Nuestros productos" debajo del hero: productos y servicios
// que salen de src/content/catalog/*.md — agregar/quitar/editar uno es
// agregar/borrar/editar un .md ahí, sin tocar este componente. Se
// muestran agrupados por tag (Productos / Servicios). Cada ítem se
// prende/apaga con su propio `enabled`; la sección entera se apaga con
// taller.catalog.enabled en site.ts. Usa el mismo sistema de esquemas de
// color (rosa/acido/azul/negro) que las secciones del fanzine.
import { getCollection } from 'astro:content';
import { taller } from '../../config/site';
import { groupCatalogItems } from '../../lib/catalog';
import CatalogCard from './CatalogCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (/^https?:\/\//.test(href) ? href : `${base}${href}`);

const allItems = taller.catalog.enabled ? await getCollection('catalog', ({ data }) => data.enabled) : [];
const sorted = allItems.sort((a, b) => a.data.order - b.data.order);
const items = sorted.slice(0, taller.catalog.limit);
const hasMore = sorted.length > items.length;
const groups = groupCatalogItems(items);
---

{
  items.length > 0 && (
    <section class={`catalog-section scheme-${taller.catalog.colorScheme}`}>
      <div class="container catalog-section__in">
        <header class="catalog-section__head">
          <span class="fz-section-title">{taller.catalog.title}</span>
          {taller.catalog.subtitle && <p class="catalog-section__subtitle">{taller.catalog.subtitle}</p>}
        </header>

        {groups.map((group) => (
          <div class="catalog-group">
            <p class="catalog-group__label">[{group.label.toUpperCase()}]</p>
            <div class="catalog-grid">
              {group.items.map((item) => (
                <CatalogCard item={item} href={withBase(`/catalogo/${item.slug}`)} />
              ))}
            </div>
          </div>
        ))}

        {(hasMore || taller.catalog.ctaLabel) && (
          <div class="catalog-section__cta-wrap">
            <a href={withBase(taller.catalog.ctaHref)} class="catalog-section__cta">
              {taller.catalog.ctaLabel}
            </a>
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .catalog-section {
    background: var(--paper);
    color: var(--ink);
    padding: 3.5rem 0;
  }
  .catalog-section__head {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  /* Título del catálogo: reusa el "sticker" .fz-section-title del sitio
     pero con la display font Anton (tipo flyer/cartel punk) y mucho más
     grande, para que se note bien la sección. */
  .catalog-section__head :global(.fz-section-title) {
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    font-size: clamp(1.9rem, 7vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    padding: 0.35em 0.9em 0.3em;
  }
  .catalog-section__subtitle {
    font-family: var(--font-head);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    opacity: 0.85;
    margin: 0.5rem 0 0;
  }

  .catalog-group + .catalog-group {
    margin-top: 2.5rem;
  }
  .catalog-group__label {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--accent);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.4rem;
    margin: 0 0 1.2rem;
  }
  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .catalog-section__cta-wrap {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }
  .catalog-section__cta {
    display: inline-block;
    text-decoration: none;
    background: var(--accent);
    color: var(--ink);
    border: var(--border-w) solid var(--ink);
    border-radius: 999px;
    padding: 0.7em 2em;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
</style>
