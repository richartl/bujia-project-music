---
// Portada/sección de revista a todo el ancho de la pantalla (full-bleed),
// con imagen de fondo — pensado para páginas sueltas tipo "Nosotros",
// no para el cuerpo angosto de un post. Se puede repetir varias veces en
// un mismo .mdx para cortar el texto en "páginas" de fanzine.
//
// 3 variantes:
//  - cover: portada larga (como abrir una revista), título gigante abajo.
//  - band: franja más corta, para separar secciones a la mitad de la página.
//  - insert: encarte fotográfico con bordes rasgados, texto chico en una esquina.
//
// Uso en MDX:
// <PageSpread variant="cover" src="/img/taller-fachada.jpg" alt="Fachada del taller"
//   tag="Bujía Project Music" title="Nosotros" subtitle="Texcoco, Edo. Méx." />
interface Props {
  src: string;
  alt: string;
  title?: string;
  tag?: string;
  subtitle?: string;
  variant?: 'cover' | 'band' | 'insert';
  colorScheme?: 'rosa' | 'acido' | 'azul' | 'negro';
  /** Apaga el degradé oscuro sobre la imagen (para fotos ya de por sí oscuras). */
  overlay?: boolean;
}
const {
  src,
  alt,
  title,
  tag,
  subtitle,
  variant = 'cover',
  colorScheme,
  overlay = true,
} = Astro.props;
---

<div
  class:list={[
    'page-spread',
    `page-spread--${variant}`,
    colorScheme && `scheme-${colorScheme}`,
    !overlay && 'page-spread--no-overlay',
  ]}
>
  <img class="page-spread__img" src={src} alt={alt} loading="lazy" />
  <span class="page-spread__grain" aria-hidden="true" />
  {overlay && <span class="page-spread__overlay" aria-hidden="true" />}

  {(title || tag || subtitle) && (
    <div class="page-spread__content">
      {tag && <span class="page-spread__tag">{tag}</span>}
      {title && (
        <p class="page-spread__title" role="heading" aria-level="2">
          {title}
        </p>
      )}
      {subtitle && <p class="page-spread__subtitle">{subtitle}</p>}
    </div>
  )}
</div>

<style>
  /* ── breakout: se sale del .container y ocupa todo el viewport ──────── */
  .page-spread {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    overflow: hidden;
    color: #fff;
    isolation: isolate;
  }
  .page-spread__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  /* Textura de puntos tipo fotocopia/halftone encima de la foto */
  .page-spread__grain {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(0, 0, 0, 0.35) 1px, transparent 1px);
    background-size: 4px 4px;
    mix-blend-mode: multiply;
    opacity: 0.35;
    pointer-events: none;
  }
  .page-spread__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .page-spread__tag {
    display: inline-block;
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.6rem;
  }
  .page-spread__title {
    font-family: 'Anton', var(--font-head);
    font-weight: 400;
    text-transform: uppercase;
    line-height: 0.95;
    margin: 0;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.5);
  }
  .page-spread__subtitle {
    font-family: var(--font-head);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.9rem;
    margin: 0.6rem 0 0;
    opacity: 0.9;
  }

  /* ── cover: larga como página de revista, título gigante abajo ──────── */
  .page-spread--cover {
    min-height: 92vh;
    display: flex;
    align-items: flex-end;
    border-bottom: var(--border-w) solid var(--ink);
  }
  .page-spread--cover .page-spread__overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.85) 0%,
      rgba(0, 0, 0, 0.35) 45%,
      rgba(0, 0, 0, 0.05) 75%
    );
  }
  .page-spread--cover .page-spread__content {
    padding: 3rem 1.5rem 3.5rem;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }
  .page-spread--cover .page-spread__title {
    font-size: clamp(3rem, 12vw, 7rem);
  }

  /* ── band: franja corta para separar secciones a la mitad de la página ─ */
  .page-spread--band {
    min-height: 38vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-top: var(--border-w) solid var(--ink);
    border-bottom: var(--border-w) solid var(--ink);
  }
  .page-spread--band .page-spread__overlay {
    background: rgba(0, 0, 0, 0.55);
  }
  .page-spread--band.scheme-rosa .page-spread__overlay {
    background: color-mix(in srgb, var(--accent) 45%, rgba(0, 0, 0, 0.55));
  }
  .page-spread--band.scheme-acido .page-spread__overlay {
    background: color-mix(in srgb, var(--accent) 45%, rgba(0, 0, 0, 0.55));
  }
  .page-spread--band.scheme-azul .page-spread__overlay {
    background: color-mix(in srgb, var(--accent) 45%, rgba(0, 0, 0, 0.55));
  }
  .page-spread--band .page-spread__content {
    padding: 2rem 1.5rem;
  }
  .page-spread--band .page-spread__title {
    font-size: clamp(2rem, 7vw, 3.6rem);
  }

  /* ── insert: encarte fotográfico, bordes rasgados, texto en una esquina ─ */
  .page-spread--insert {
    min-height: 60vh;
    display: flex;
    align-items: flex-start;
    clip-path: polygon(
      0% 2%, 4% 0%, 9% 3%, 15% 0%, 21% 2%, 27% 0%, 33% 3%, 39% 0%, 45% 2%,
      51% 0%, 57% 3%, 63% 0%, 69% 2%, 75% 0%, 81% 3%, 87% 0%, 93% 2%, 100% 0%,
      100% 98%, 95% 100%, 90% 97%, 84% 100%, 78% 98%, 72% 100%, 66% 97%,
      60% 100%, 54% 98%, 48% 100%, 42% 97%, 36% 100%, 30% 98%, 24% 100%,
      18% 97%, 12% 100%, 6% 98%, 0% 100%
    );
  }
  .page-spread--insert .page-spread__overlay {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, transparent 30%);
  }
  .page-spread--insert .page-spread__content {
    padding: 3rem 1.5rem 0;
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
  }
  .page-spread--insert .page-spread__tag {
    background: var(--paper, #fff);
    color: var(--ink, #000);
    padding: 0.3em 0.9em;
    transform: rotate(-2deg);
  }
  .page-spread--insert .page-spread__title {
    font-size: clamp(1.6rem, 5vw, 2.6rem);
  }

  .page-spread--no-overlay .page-spread__overlay {
    display: none;
  }

  @media (max-width: 640px) {
    .page-spread--cover {
      min-height: 70vh;
    }
    .page-spread--insert {
      min-height: 45vh;
    }
  }
</style>
