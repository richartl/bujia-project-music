---
// Cita grande destacada, con comillas gigantes y borde grueso. Para
// frases de clientes, letras de canciones, lo que sea.
// Uso: <Quote cite="Ale, cliente del taller">Quedó sonando mejor que nueva.</Quote>
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---

<figure class="pk-quote">
  <span class="pk-quote__mark" aria-hidden="true">“</span>
  <blockquote>
    <slot />
  </blockquote>
  {cite && <figcaption>— {cite}</figcaption>}
</figure>

<style>
  .pk-quote {
    position: relative;
    margin: 2.5rem 0;
    padding: 0.5rem 1.5rem 0.5rem 2.2rem;
    border-left: var(--border-w) solid var(--ink);
  }
  .pk-quote__mark {
    position: absolute;
    left: -0.15em;
    top: -0.5rem;
    font-family: 'Anton', var(--font-head);
    font-size: 4rem;
    line-height: 1;
    color: var(--accent);
    -webkit-text-stroke: 1.5px var(--ink);
  }
  .pk-quote blockquote {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.35;
    text-transform: uppercase;
  }
  .pk-quote figcaption {
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
