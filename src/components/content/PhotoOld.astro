---
// Foto vieja: sepia, viñeta, esquinas de cinta y ligera inclinación —
// para fotos de archivo, del taller hace años, etc.
// Uso: <PhotoOld src="/img/taller-2019.jpg" alt="El taller en 2019" caption="El local, 2019" tilt={2} />
interface Props {
  src: string;
  alt: string;
  caption?: string;
  tilt?: number;
}
const { src, alt, caption, tilt = -2 } = Astro.props;
---

<figure class="photo-old" style={`--tilt:${tilt}deg`}>
  <span class="photo-old__tape photo-old__tape--l" aria-hidden="true" />
  <span class="photo-old__tape photo-old__tape--r" aria-hidden="true" />
  <span class="photo-old__frame">
    <img src={src} alt={alt} loading="lazy" />
  </span>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo-old {
    display: table;
    margin: 2rem auto;
    transform: rotate(var(--tilt));
  }
  .photo-old__frame {
    display: block;
    position: relative;
    padding: 10px;
    background: #efe4c8;
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
  }
  .photo-old__frame img {
    display: block;
    filter: sepia(0.55) contrast(1.05) brightness(0.95);
  }
  .photo-old__frame::after {
    content: '';
    position: absolute;
    inset: 10px;
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.45);
    pointer-events: none;
  }
  .photo-old__tape {
    position: absolute;
    width: 60px;
    height: 22px;
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(0, 0, 0, 0.1);
    top: -10px;
    z-index: 2;
  }
  .photo-old__tape--l {
    left: -14px;
    transform: rotate(-35deg);
  }
  .photo-old__tape--r {
    right: -14px;
    transform: rotate(35deg);
  }
  .photo-old figcaption {
    font-family: var(--font-head);
    font-size: 0.8rem;
    text-align: center;
    padding-top: 0.6em;
    color: #443;
  }
</style>
